# 基础设施与环境配置
APP_NAME=StockFinanceApp
ENVIRONMENT=development
LOG_LEVEL=INFO

# 数据存储目录配置
DATA_DIR=./data
CACHE_DIR=./data/cache
DATA_SOURCE_MODE=tushare

# 外部数据接口 Token 与服务器配置（样例）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_URL=http://api.tushare.pro

# 理杏仁 (Lixinger) 接口配置
LIXINGER_TOKEN=your_lixinger_token_here
LIXINGER_URL=https://open.lixinger.com

# AKSHARE接口配置
AKSHARE_PROXY=

# YFINANCE接口配置
YFINANCE_PROXY=
# 可选：本地代理池文件/目录，每行一个代理；目录默认读取 yfinance.txt
YFINANCE_PROXY_POOL_FILE=./data/proxy

# ALPHA接口配置
ALPHA_VANTAGE_API_KEY=
