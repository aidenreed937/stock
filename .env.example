# 基础设施与环境配置
APP_NAME=StockFinanceApp
ENVIRONMENT=development
LOG_LEVEL=INFO

# 数据存储目录配置
DATA_DIR=./data
CACHE_DIR=./data/cache
DATA_SOURCE_MODE=tushare

# 外部数据接口 Token 与服务器配置（样例）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_URL=http://api.tushare.pro

# 理杏仁 (Lixinger) 接口配置
LIXINGER_TOKEN=your_lixinger_token_here
LIXINGER_URL=https://open.lixinger.com
# 可选：多个已授权 Token 的 profile（JSON）
# LIXINGER_TOKENS='{"primary":"your_primary_token_here","backup_1":"your_backup_token_here","backup_2":"your_second_backup_token_here"}'
# LIXINGER_PROFILE=primary
# LIXINGER_FALLBACK_PROFILES='["backup_1","backup_2"]'

# AKSHARE接口配置
AKSHARE_PROXY=

# YFINANCE接口配置
YFINANCE_PROXY=
# 可选：本地代理池文件/目录，每行一个代理；目录默认读取 yfinance.txt
YFINANCE_PROXY_POOL_FILE=./data/proxy

# Susquehanna/Industry 公开报道采集代理（HTTP/HTTPS 或 SOCKS5）
SUSQUEHANNA_PROXY=

# ALPHA接口配置
ALPHA_VANTAGE_API_KEY=
# 可选：多个已授权 Key，JSON 数组；主 Key 与池内重复项会自动去重
# ALPHA_VANTAGE_API_KEYS='["key_primary","key_backup_1","key_backup_2"]'


# UN Comtrade 官方贸易接口配置 (Primary Subscription Key)
COMTRADE_SUBSCRIPTION_KEY=your_32bit_key

# DRAMeXchange 历史价格页登录 Cookie
# 由 scripts/probe_dramexchange_history.py 读取（历史价格查询需登录，TrendForce 系账号）；
# 登录 dramexchange.com 后在浏览器开发者工具复制 Cookie 头值填入 .env（勿提交真实值）。
DRAMEXCHANGE_COOKIE=

# 多模态视觉大模型 (VLM) 与 LLM 统一配置 (基于 litellm，支持 100+ 平台: Gemini, OpenAI, Claude, DeepSeek, Ollama 等)
# 常用模型示例:
#   Gemini:  gemini/gemini-2.5-flash 或 gemini/gemini-1.5-pro
#   OpenAI:  gpt-4o 或 gpt-4o-mini
#   Claude:  anthropic/claude-3-5-sonnet-20241022
#   Ollama:  ollama/llava 或 ollama/qwen2-vl
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# 思考模式与推理强度: low (轻度思考), medium (适中), high (深度强推理，研报复杂图表推荐 medium 或 high)
LLM_REASONING_EFFORT=medium
# 开启流式防超时 (官方建议配合思考模式开启)
LLM_STREAM=true
