# 基础设施与环境配置
APP_NAME=StockFinanceApp
ENVIRONMENT=development
LOG_LEVEL=INFO

# 数据存储目录配置
DATA_DIR=./data
CACHE_DIR=./data/cache
DATA_SOURCE_MODE=tushare
DEFAULT_BENCHMARK_INDEX_CODE=000001

# 外部数据接口 Token 与服务器配置（样例）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_URL=http://api.tushare.pro
TUSHARE_RATE_LIMIT_PER_MIN=200
TUSHARE_MAX_WORKERS=4
AKSHARE_PROXY=
YFINANCE_PROXY=
YFINANCE_RATE_LIMIT_PER_MIN=60

# 理杏仁 (Lixinger) 接口配置
LIXINGER_TOKEN=your_lixinger_token_here
LIXINGER_URL=https://open.lixinger.com
LIXINGER_RATE_LIMIT_PER_MIN=1000
