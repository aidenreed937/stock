# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environments & Virtual Envs
.venv/
env/
venv/
ENV/
.python-version

# Distribution / packaging
build/
dist/
*.egg/
*.egg-info/

# Unit test & coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# CodeGraph 本地索引
.codegraph/

# uv 本地缓存
.uv-cache/
.uv_cache/
.uv_python/

# Financial Data & Local Cache & Databases (排除本地数据文件，保留目录结构)
data/*
!data/raw/
!data/curated/
!data/cache/
!data/**/.gitkeep
data/audit/
*.parquet
*.feather
*.db
*.duckdb
*.sqlite
*.sqlite3
*.log

# Sensitive Environment Variables (环境变量与密钥绝不提交)
.env
.env.local
.env.*.local
!.env.example

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
